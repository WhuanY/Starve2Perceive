# Template for train/rl/verl_starve/.env — copy to `.env` and edit.
# The real .env is gitignored (it is machine-local and may hold tokens).
#
# Sourced via `set -a; source .env; set +a`, so everything here is auto-exported.
# REPO_ROOT is set by the launcher before this file is sourced.

# Conda env to run in (activated by the launcher).
VENV_DIR=/opt/conda/envs/starve

# Run logs.
LOG_DIR=${REPO_ROOT}/train/rl/verl_starve/logs

# Checkpoints + tensorboard + rl_logging_board root.
SAVE_CHECKPOINT_DIR=${REPO_ROOT}/train/rl/verl_starve/checkpoints

# Container sets this to 1, but hf_transfer isn't in requirements_ustsuperpod.txt,
# which makes every huggingface_hub call raise. Turn it off.
HF_HUB_ENABLE_HF_TRANSFER=0
