# ---------------------------------------------------------------------------
# Starve2Perceive — source-code-only repository.
# Model weights and dataset artifacts are downloaded/regenerated by the
# scripts under data/ (hfd.sh, download.sh, *_to_fixretina.py) and are never
# committed here.
# ---------------------------------------------------------------------------

# Model weights / checkpoints.
# NOTE: anchored to the repo root on purpose — train/rl/verl_starve/verl/models/
# is verl source code, not weights.
/models/
checkpoints/
**/checkpoints/
*.safetensors
*.bin
*.pt
*.pth
*.ckpt
*.gguf

# Dataset artifacts (parquet shards, packed images, tarballs)
*.parquet
*.parquet.bak
*.arrow
*.lmdb
*.tsv
*.zip
*.tar
*.tar.gz
*.h5
*.npy
*.npz

# Raw image/video payloads pulled down by the dataset scripts.
# assets/ is whitelisted below because README.md embeds those figures.
*.jpg
*.jpeg
*.gif
*.bmp
*.webp
*.mp4
*.avi
*.mp3
*.wav
*.flac
!assets/**

# hfdownloader metadata (may contain HF tokens)
.hfd/
**/.hfd/

# Run artifacts: logs, hydra outputs, tensorboard, wandb
logs/
**/logs/
outputs/
**/outputs/
tensorboard/
**/tensorboard/
rl_logging_board/
**/rl_logging_board/
wandb/
**/wandb/
*.log

# Python
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/
.pytest_cache/
.ipynb_checkpoints/
.venv/
venv/
